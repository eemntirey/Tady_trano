<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mg.emit.tadytrano.client.controller.RechercheController"
      spacing="15" style="-fx-padding: 20;">
    <children>
        <Label text="Recherche d'annonces" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label fx:id="labelStatutConnexion" text="Non connecte"/>
        <GridPane hgap="10" vgap="10">
            <children>
                <Label text="Type de location :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboType" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Prix min (Ar) :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="champPrixMin" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Prix max (Ar) :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="champPrixMax" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Nb pieces min :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="spinnerPiecesMin" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Quartier :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboQuartier" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </children>
            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
        </GridPane>
        <Button text="Rechercher" onAction="#rechercher"/>
    </children>
</VBox>
